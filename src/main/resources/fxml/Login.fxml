      </VBox>
      <VBox layoutX="210.0" layoutY="12.0" prefHeight="370.0" prefWidth="373.0" AnchorPane.bottomAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
