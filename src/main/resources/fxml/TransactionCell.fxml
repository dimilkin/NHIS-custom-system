<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="60.0" prefWidth="400.0" styleClass="transaction_container"
            stylesheets="@../styles/transaction_cell.css" xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1">
    <children>

        <Label fx:id="transaction_cell_first_name" layoutX="38.0" layoutY="22.0" text="Екатерина">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>
        <Label fx:id="transaction_cell_family_name" layoutX="124.0" layoutY="22.0" text="Симеонова">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>
        <Label fx:id="transaction_cell_time" layoutX="248.0" layoutY="22.0" text="14:35"/>
        <Label fx:id="transaction_cell_date" layoutX="311.0" layoutY="22.0" text="22.04.2222">
            <font>
                <Font name="System Bold" size="13.0"/>
            </font>
        </Label>
        <Line fx:id="transaction_cell_line_one" endX="75.0" endY="-15.0" layoutX="220.0" layoutY="30.0" startX="75.0"
              startY="15.0" stroke="GREEN"/>
        <Line fx:id="transaction_cell_line_two" endX="75.0" endY="-15.0" layoutX="160.0" layoutY="30.0" startX="75.0"
              startY="15.0" stroke="GREEN"/>
        <FontAwesomeIconView id="cell_arrow" fill="GREEN" glyphName="LONG_ARROW_DOWN" layoutX="14.0" layoutY="38.0"
                             size="20"/>
    </children>
</AnchorPane>
