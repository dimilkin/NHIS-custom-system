<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane prefHeight="444.0" prefWidth="552.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nzis.ignatovsoft.front.controllers.ExamDetailsWindowController">

    <Label layoutX="242.0" layoutY="14.0" text="Exam Details" AnchorPane.leftAnchor="242.0" AnchorPane.topAnchor="14.0" />
    <GridPane hgap="10" layoutX="14.0" layoutY="198.0" prefHeight="186.0" prefWidth="523.0" vgap="10">

        <Label text="Diagnosis Main Description:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <Label fx:id="diagnosisMainDescription" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label text="Exam Status:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <Label fx:id="examStatus" GridPane.columnIndex="3" GridPane.rowIndex="2" />
         </GridPane>

    <Button fx:id="closeButton" layoutX="253.0" layoutY="404.0" text="Close" />

     <Label fx:id="examinationDate" layoutX="23.0" layoutY="60.0" prefHeight="17.0" prefWidth="100.0" text="text" />

     <Label fx:id="patientFirstName" layoutX="135.0" layoutY="60.0" prefHeight="17.0" prefWidth="100.0" text="text" />

     <Label fx:id="patientLastName" layoutX="248.0" layoutY="60.0" prefHeight="17.0" prefWidth="100.0" text="text" />

     <Label fx:id="patientIdentifierValue" layoutX="404.0" layoutY="60.0" prefHeight="17.0" prefWidth="100.0" text="text" />
</AnchorPane>
