<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="557.0" prefWidth="454.0" styleClass="vbox"
      stylesheets="@../styles/patient_details.css" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nzis.ignatovsoft.front.controllers.NewPatientDetailsController">

    <Label fx:id="addEditPatientTitle" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 10px;"
           text="New Patient"/>

    <GridPane alignment="CENTER" hgap="10" prefHeight="309.0" prefWidth="443.0" vgap="10">

        <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="firstNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Middle Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="middleNameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="lastNameField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Identifier:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="identifierComboBox" prefHeight="25.0" prefWidth="159.0" GridPane.columnIndex="1"
                  GridPane.rowIndex="3"/>
        <TextField fx:id="identifierValueField" GridPane.columnIndex="2" GridPane.rowIndex="3"/>

        <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Country of Origin:" GridPane.rowIndex="7"/>
        <ComboBox fx:id="countryComboBox" prefHeight="25.0" prefWidth="161.0" GridPane.columnIndex="1"
                  GridPane.rowIndex="7"/>

        <Label text="County of Origin:" GridPane.rowIndex="6"/>
        <ComboBox fx:id="countyBox" prefHeight="25.0" prefWidth="161.0" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

        <Label text="City:" GridPane.rowIndex="5"/>
        <TextField fx:id="addressCityName" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="Gender" GridPane.rowIndex="8"/>
        <ComboBox fx:id="genderBox" prefHeight="25.0" prefWidth="161.0" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

        <Label text="Birth Date:" GridPane.rowIndex="9"/>
        <DatePicker fx:id="birthDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

        <columnConstraints>
            <ColumnConstraints/>
            <ColumnConstraints maxWidth="190" minWidth="140" prefWidth="160"/>
            <ColumnConstraints maxWidth="190" minWidth="140" prefWidth="168"/>
        </columnConstraints>
    </GridPane>

    <Label fx:id="errorTextField" style="-fx-font-size: 16px; -fx-text-fill: #8B0000; -fx-padding: 10px;" text="Error"/>

    <Button fx:id="saveButton" minHeight="-Infinity" minWidth="-Infinity" prefHeight="40.0" prefWidth="120.0"
            styleClass="save-patient-button" text="Save">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
    </Button>
</VBox>
