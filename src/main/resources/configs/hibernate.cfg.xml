<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- JDBC Database connection settings -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">milkinis</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:4567/Astraia</property>
        <property name="hibernate.default_schema">healthcare</property>



        <!-- JDBC connection pool settings ... using built-in test pool -->
        <property name="connection.pool_size">1</property>

        <!-- Select our SQL dialect -->

        <!-- Echo all executed SQL to stdout -->
        <property name="show_sql">true</property>

        <!-- Drop and re-create the database schema on startup -->
        <property name="hbm2ddl.auto">none</property>

        <!-- Mention your entity classes here -->
        <mapping class="com.nzis.ignatovsoft.database.astraiadb.models.AstraiaPatient"/>
        <mapping class="com.nzis.ignatovsoft.database.astraiadb.models.AstraiaExamination"/>
        <mapping class="com.nzis.ignatovsoft.database.localdb.models.ExamDbModel"/>
        <mapping class="com.nzis.ignatovsoft.database.localdb.models.PatientDbModel"/>
        <mapping class="com.nzis.ignatovsoft.database.localdb.models.DiagnosisDbModel"/>
        <mapping class="com.nzis.ignatovsoft.database.localdb.models.PracticeInfo"/>
        <!-- Add more mapping classes if needed -->
    </session-factory>
</hibernate-configuration>


